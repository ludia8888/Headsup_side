{
  "name": "jimin-mvp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "setup:openai": "node scripts/configure-openai.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
